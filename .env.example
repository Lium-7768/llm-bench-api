# 本地开发环境变量示例。复制为 .env.local 后按需修改。

# 允许把 baseUrl 指向 localhost / 内网（用于评测 Ollama、LM Studio、vLLM 等本地模型）。
# 公网部署时千万不要开启，否则接口会变成内网探测工具（SSRF）。
ALLOW_PRIVATE_BASE_URL=false

# 隐藏彩蛋（编程段位赛）的签名密钥，至少 16 个字符的随机串，如 openssl rand -hex 24 生成。
# 不设置时彩蛋整个关闭。只放在部署平台的环境变量里，不要提交到仓库。
LLMBENCH_SECRET=

# 彩蛋用到的代码执行服务（开源的 Judge0），默认官方公共实例；自建时填自己的地址，开了鉴权再填令牌。
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_AUTH_TOKEN=
