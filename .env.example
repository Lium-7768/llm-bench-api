# 本地开发环境变量示例。复制为 .env.local 后按需修改。

# 允许把 baseUrl 指向 localhost / 内网（用于评测 Ollama、LM Studio、vLLM 等本地模型）。
# 公网部署时千万不要开启，否则接口会变成内网探测工具（SSRF）。
ALLOW_PRIVATE_BASE_URL=false

# 可选：启用 Redis 持久化存储。两个都填才会生效。
# 在 Vercel 上通过 Integrations 接入 Upstash Redis 会自动注入这两个变量。
# 不填则回退到进程内存（Serverless 冷启动会清空记录）。
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
